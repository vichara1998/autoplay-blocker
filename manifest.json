{
  "manifest_version": 3,
  "name": "Autoplay Blocker for Social Feeds",
  "short_name": "Autoplay Blocker",
  "version": "1.0.0",
  "description": "Stops Instagram, Facebook, X/Twitter, TikTok, LinkedIn, Reddit, Pinterest and Threads from automatically playing videos while you scroll.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Autoplay Blocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://*.facebook.com/*",
    "*://*.fb.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.tiktok.com/*",
    "*://*.linkedin.com/*",
    "*://*.reddit.com/*",
    "*://*.pinterest.com/*",
    "*://*.threads.net/*",
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.tiktok.com/*",
        "*://*.linkedin.com/*",
        "*://*.reddit.com/*",
        "*://*.pinterest.com/*",
        "*://*.threads.net/*",
        "*://*.youtube.com/*"
      ],
      "js": ["src/page-guard.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.instagram.com/*",
        "*://*.facebook.com/*",
        "*://*.fb.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.tiktok.com/*",
        "*://*.linkedin.com/*",
        "*://*.reddit.com/*",
        "*://*.pinterest.com/*",
        "*://*.threads.net/*",
        "*://*.youtube.com/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
